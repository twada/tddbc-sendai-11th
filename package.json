{
  "name": "tddbc-sendai-11th",
  "version": "0.0.0",
  "private": true,
  "description": "TDDBC 仙台 11th: 限定仕様のモルックを題材にした TDD 演習",
  "type": "module",
  "scripts": {
    "test": "node --enable-source-maps --disable-warning=ExperimentalWarning --import @power-assert/node --test \"src/__tests__/**/*.test.ts\"",
    "test:watch": "node --enable-source-maps --disable-warning=ExperimentalWarning --import @power-assert/node --test --watch \"src/__tests__/**/*.test.ts\"",
    "test:coverage": "node --enable-source-maps --disable-warning=ExperimentalWarning --import @power-assert/node --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/__tests__/**\" --test-coverage-include-all --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test \"src/__tests__/**/*.test.ts\"",
    "mutation": "stryker run",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm run test:coverage"
  },
  "devDependencies": {
    "@power-assert/node": "^0.7.2",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
